# Bakery App Environment Variables

# Database
DATABASE_URL=postgresql://bakery_user:bakery_pass@localhost:5432/bakery_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# EasyPaisa
EASYPAISA_STORE_ID=your-easypaisa-store-id
EASYPAISA_SECRET_KEY=your-easypaisa-secret-key
EASYPAISA_API_URL=https://easypay1.easypaisa.com.pk/easypay-service/rest/v4/initiate-transaction
EASYPAISA_RETURN_URL=http://localhost:4200/checkout/processing
EASYPAISA_MERCHANT_HASH_URL=https://easypay1.easypaisa.com.pk/easypay-service/rest/v4/generate-merchant-hash

# JazzCash
JAZZCASH_MERCHANT_ID=your-jazzcash-merchant-id
JAZZCASH_PASSWORD=your-jazzcash-password
JAZZCASH_HASH_KEY=your-jazzcash-hash-key
JAZZCASH_RETURN_URL=http://localhost:4200/checkout/processing
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=noreply@yourbakery.com

# App
PORT=3000
FRONTEND_URL=http://localhost:4200
ADMIN_URL=http://localhost:4201
UPLOAD_DEST=./uploads
NODE_ENV=development
