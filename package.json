{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:admin": "nx serve admin",
    "dev:user": "nx serve user",
    "dev:backend": "nx serve backend",
    "dev:all": "nx run-many -t serve -p admin user backend --parallel=3",
    "start:admin": "nx serve admin",
    "start:user": "nx serve user",
    "start:backend": "nx serve backend",
    "build:admin": "nx build admin",
    "build:user": "nx build user",
    "build:backend": "nx build backend",
    "build:all": "nx run-many -t build -p admin user backend",
    "db:seed": "npx ts-node -e \"require('./apps/backend/src/seed/seed.ts').seedDynamoDB()\"",
    "seed": "npx ts-node apps/backend/src/seed/seed.ts",
    "create:admin": "npx ts-node --transpile-only apps/backend/src/scripts/create-admin.ts",
    "cdk:synth": "cd infra && npx cdk synth",
    "cdk:diff": "cd infra && npx cdk diff",
    "cdk:bootstrap": "cd infra && npx cdk bootstrap",
    "cdk:deploy": "npm run build:all && cd infra && npx cdk deploy --require-approval never",
    "cdk:destroy": "cd infra && npx cdk destroy",
    "deploy:all": "npm run build:all && cd infra && npx cdk deploy --require-approval never"
  },
  "private": true,
