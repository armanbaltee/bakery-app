<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: 'Georgia', serif; background: #FDF6EC; color: #3D1A0A; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 12px; overflow: hidden; }
    .header { background: #7C4A2D; padding: 32px; text-align: center; }
    .header h1 { color: #FDF6EC; margin: 0; font-size: 28px; }
    .header p { color: #F2B5A0; margin: 8px 0 0; }
    .body { padding: 32px; }
    .order-number { background: #FDF6EC; border-radius: 8px; padding: 16px; text-align: center; margin-bottom: 24px; }
    .order-number strong { font-size: 20px; color: #7C4A2D; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
    th { background: #7C4A2D; color: #FDF6EC; padding: 10px 12px; text-align: left; }
    td { padding: 10px 12px; border-bottom: 1px solid #F2B5A0; }
    .total-row td { font-weight: bold; background: #FDF6EC; }
    .address-box { background: #FDF6EC; border-radius: 8px; padding: 16px; margin-bottom: 24px; }
    .footer { background: #3D1A0A; color: #F2B5A0; text-align: center; padding: 20px; font-size: 13px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🎂 Order Confirmed!</h1>
      <p>Thank you for your order, {{name}}!</p>
    </div>
    <div class="body">
      <div class="order-number">
        <p>Your Order Number</p>
        <strong>{{orderNumber}}</strong>
      </div>

      <h3>Order Summary</h3>
      <table>
        <thead>
          <tr>
            <th>Item</th>
            <th>Qty</th>
            <th>Price</th>
          </tr>
        </thead>
        <tbody>
          {{#each items}}
          <tr>
            <td>
              {{this.productName}}
              {{#if this.customizations.weight}}<br><small>Weight: {{this.customizations.weight}}</small>{{/if}}
              {{#if this.customizations.flavor}}<br><small>Flavor: {{this.customizations.flavor}}</small>{{/if}}
              {{#if this.customizations.cakeMessage}}<br><small>Message: "{{this.customizations.cakeMessage}}"</small>{{/if}}
            </td>
            <td>{{this.quantity}}</td>
            <td>PKR {{this.totalPrice}}</td>
          </tr>
          {{/each}}
          <tr>
            <td colspan="2">Subtotal</td>
            <td>PKR {{subtotal}}</td>
          </tr>
          <tr>
            <td colspan="2">Delivery Charge</td>
            <td>PKR {{deliveryCharge}}</td>
          </tr>
          <tr class="total-row">
            <td colspan="2">Total</td>
            <td>PKR {{totalAmount}}</td>
          </tr>
        </tbody>
      </table>

      <div class="address-box">
        <h4 style="margin-top:0">Delivery Address</h4>
        <p>{{deliveryAddress.street}}, {{deliveryAddress.city}}</p>
        {{#if deliveryAddress.province}}<p>{{deliveryAddress.province}} {{deliveryAddress.postalCode}}</p>{{/if}}
        <p>📞 {{deliveryAddress.contactPhone}}</p>
      </div>

      <p>We'll notify you as your order progresses. You can track your order in your account.</p>
    </div>
    <div class="footer">
      <p>© {{year}} Bakery. Made with ❤️ and flour.</p>
    </div>
  </div>
</body>
</html>
