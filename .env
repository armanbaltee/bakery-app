# Bakery App Environment Variables

# ─── Database ─────────────────────────────────────────────────────────────────
# Using local PostgreSQL 18 (pgAdmin) with the default postgres superuser
# Replace YOUR_POSTGRES_PASSWORD with the password you set during PostgreSQL install
DATABASE_URL=postgresql://postgres:password@localhost:5432/bakery_db
# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=bakery-super-secret-jwt-key-local-dev
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=bakery-refresh-secret-local-dev
JWT_REFRESH_EXPIRES_IN=30d

# ─── EasyPaisa (leave as-is for local dev, not needed to run) ─────────────────
EASYPAISA_STORE_ID=test-store-id
EASYPAISA_SECRET_KEY=test-secret-key
EASYPAISA_API_URL=https://easypay1.easypaisa.com.pk/easypay-service/rest/v4/initiate-transaction
EASYPAISA_RETURN_URL=http://localhost:4200/checkout/processing
EASYPAISA_MERCHANT_HASH_URL=https://easypay1.easypaisa.com.pk/easypay-service/rest/v4/generate-merchant-hash

# ─── JazzCash (leave as-is for local dev, not needed to run) ──────────────────
JAZZCASH_MERCHANT_ID=test-merchant-id
JAZZCASH_PASSWORD=test-password
JAZZCASH_HASH_KEY=test-hash-key
JAZZCASH_RETURN_URL=http://localhost:4200/checkout/processing
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# ─── Email / SMTP (leave as-is for local dev, not needed to run) ──────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@gmail.com
SMTP_PASS=test-app-password
MAIL_FROM=noreply@bakery.com

# ─── App ───────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:4200
ADMIN_URL=http://localhost:4201
UPLOAD_DEST=./uploads
NODE_ENV=development
